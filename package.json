{
  "name": "anplexa-monorepo",
  "version": "1.0.0",
  "description": "Anplexa unified monorepo - consolidated backend, companions app, funnel app, and documentation",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "clean": "turbo run clean",
    "start": "cd apps/api && node dist/index.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@mapbox/node-pre-gyp": "^2.0.3",
    "@types/pg": "^8.11.6",
    "@types/uuid": "^9.0.0",
    "eslint": "^9.39.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.53.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.0"
}
