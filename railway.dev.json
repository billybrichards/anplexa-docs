{
  "projectName": "anplexa-dev",
  "projectId": "INSERT_DEV_PROJECT_ID",
  "environment": "development",
  "services": {
    "api": {
      "name": "api",
      "source": "apps/api",
      "buildCommand": "pnpm install --frozen-lockfile && pnpm build --filter=api",
      "startCommand": "pnpm start --filter=api",
      "environmentVariables": {
        "NODE_ENV": "development",
        "DATABASE_URL": "${{postgres.DATABASE_URL}}",
        "REDIS_URL": "${{redis.REDIS_URL}}",
        "PORT": "3000"
      }
    },
    "companions": {
      "name": "companions",
      "source": "apps/companions",
      "buildCommand": "pnpm install --frozen-lockfile && pnpm build --filter=companions",
      "startCommand": "pnpm start --filter=companions",
      "environmentVariables": {
        "NODE_ENV": "development",
        "DATABASE_URL": "${{postgres.DATABASE_URL}}",
        "NEXT_PUBLIC_API_URL": "http://localhost:3000",
        "PORT": "3001"
      }
    },
    "funnel": {
      "name": "funnel",
      "source": "apps/funnel",
      "buildCommand": "pnpm install --frozen-lockfile && pnpm build --filter=funnel",
      "startCommand": "pnpm start --filter=funnel",
      "environmentVariables": {
        "NODE_ENV": "development",
        "DATABASE_URL": "${{postgres.DATABASE_URL}}",
        "NEXT_PUBLIC_API_URL": "http://localhost:3000",
        "PORT": "3002"
      }
    },
    "docs": {
      "name": "docs",
      "source": "apps/docs",
      "buildCommand": "pnpm install --frozen-lockfile && pnpm build --filter=docs",
      "startCommand": "pnpm start --filter=docs",
      "environmentVariables": {
        "NODE_ENV": "development",
        "PORT": "3003"
      }
    }
  },
  "databases": {
    "postgres": {
      "type": "postgresql",
      "name": "postgres",
      "version": "latest"
    },
    "redis": {
      "type": "redis",
      "name": "redis",
      "version": "latest"
    }
  }
}
