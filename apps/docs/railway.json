{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "cd ../.. && pnpm install --frozen-lockfile && pnpm build --filter=@anplexa/docs",
    "watchPatterns": [
      "apps/docs/**"
    ]
  },
  "deploy": {
    "startCommand": "pnpm start --port $PORT --host 0.0.0.0",
    "healthcheckPath": "/",
    "healthcheckTimeout": 100,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
