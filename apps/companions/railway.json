{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "pnpm install --frozen-lockfile && pnpm build --filter=@anplexa/companions...",
    "nixpacksConfigPath": "apps/companions/nixpacks.toml",
    "watchPatterns": [
      "apps/companions/**",
      "packages/ui/**"
    ]
  },
  "deploy": {
    "startCommand": "cd apps/companions && pnpm start",
    "healthcheckPath": "/",
    "healthcheckTimeout": 100,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
