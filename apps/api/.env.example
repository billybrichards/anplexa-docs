# Anplexa API — Environment Variables
# Copy to .env and fill in values

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/anplexa

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=your-jwt-secret-here
CORS_ORIGIN=http://localhost:3000

# ── Letta (AI Agent Server) ──────────────────────────────────────────────────
LETTA_API_URL=http://95.35.246.214:40083
LETTA_API_KEY=
LETTA_CHAT_MODEL=ollama/qwen3-8b-nsfw:latest
LETTA_EMBEDDING_MODEL=ollama/nomic-embed-text:latest
LETTA_CONTEXT_WINDOW=32768

# ── Ollama (Local LLM) ──────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://95.35.246.214:40042
OLLAMA_API_KEY=

# ── Anthropic (Fallback for trait analysis) ──────────────────────────────────
# When set, uses Claude for trait enrichment instead of mock data
ANTHROPIC_API_KEY=

# ── ComfyUI (Media Generation) ──────────────────────────────────────────────
COMFYUI_API_URL=http://89.221.67.149:42840
COMFYUI_API_KEY=

# ── AWS S3 (Media Storage) ──────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=anplexa-media
AWS_REGION=us-east-1
