# Anplexa API — Environment Variables
# Copy to .env and fill in values

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/anplexa

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=your-jwt-secret-here
CORS_ORIGIN=http://localhost:3000
ADMIN_UI_PASSWORD=doomdoom

# ── Letta (AI Agent Server) ──────────────────────────────────────────────────
LETTA_API_URL=http://localhost:8283
LETTA_API_KEY=
LETTA_CHAT_MODEL=ollama/qwen3-8b-nsfw:latest
LETTA_EMBEDDING_MODEL=ollama/nomic-embed-text:latest
# Context window is auto-derived from the model by Letta server

# ── Ollama (Local LLM) ──────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_API_KEY=

# ── Anthropic (Fallback for trait analysis) ──────────────────────────────────
# When set, uses Claude for trait enrichment instead of mock data
ANTHROPIC_API_KEY=

# ── ComfyUI (Media Generation) ──────────────────────────────────────────────
COMFYUI_API_URL=http://localhost:8188
COMFYUI_API_KEY=

# ── AWS S3 (Media Storage) ──────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=anplexa-media
AWS_REGION=us-east-1
